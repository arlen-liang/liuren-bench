{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arlen-liang/liuren-bench/docs/schema/live-1.json",
  "title": "liuren-live/1 实占案例",
  "type": "object",
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "stamp": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"},
    "outcome": {"enum": ["成", "不成"]},
    "judge": {
      "oneOf": [
        {"type": "object", "required": ["human"], "properties": {"human": {"const": true}}, "additionalProperties": false},
        {"type": "object", "required": ["model", "harness", "skill", "tools"],
         "properties": {"model": {"type": "string"}, "harness": {"type": "string"}, "skill": {"type": "string"},
                        "tools": {"type": ["boolean", "null"]}},
         "additionalProperties": false}
      ]
    }
  },
  "required": ["format", "id", "url", "owner", "question", "category", "deadline", "sealed_at", "cast", "flags", "verdicts", "result", "status"],
  "properties": {
    "format": {"const": "liuren-live/1"},
    "id": {"type": "integer"},
    "url": {"type": "string"},
    "owner": {"type": "string"},
    "question": {"type": "string"},
    "category": {"enum": ["求职", "工作", "财运", "感情", "健康（仅限本人）", "出行", "失物", "考试", "其他"]},
    "deadline": {"$ref": "#/$defs/date"},
    "sealed_at": {"$ref": "#/$defs/stamp"},
    "cast": {
      "type": "object",
      "required": ["time", "chart"],
      "properties": {
        "time": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$"},
        "chart": {"$ref": "chart-1.json"}
      }
    },
    "flags": {"type": "array", "items": {"type": "string"}},
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sealed_at", "source", "author", "judge", "complete", "outcome", "window", "confidence", "basis",
                     "judge_key", "self_reported", "hindsight", "falsifiable"],
        "properties": {
          "sealed_at": {"$ref": "#/$defs/stamp"},
          "source": {"type": "string"},
          "author": {"type": "string"},
          "judge": {"$ref": "#/$defs/judge"},
          "complete": {"type": "boolean"},
          "outcome": {"$ref": "#/$defs/outcome"},
          "window": {
            "oneOf": [
              {"type": "null"},
              {"type": "object", "required": ["from", "to"],
               "properties": {"from": {"$ref": "#/$defs/date"}, "to": {"$ref": "#/$defs/date"}},
               "additionalProperties": false}
            ]
          },
          "confidence": {"type": "number", "minimum": 0.5, "maximum": 1.0},
          "basis": {"type": "string"},
          "judge_key": {"type": "string"},
          "self_reported": {"const": true},
          "hindsight": {"type": "boolean"},
          "falsifiable": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "result": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "required": ["sealed_at", "source", "author", "outcome", "date", "note"],
         "properties": {"sealed_at": {"$ref": "#/$defs/stamp"}, "source": {"type": "string"}, "author": {"type": "string"},
                        "outcome": {"$ref": "#/$defs/outcome"}, "date": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/date"}]},
                        "note": {"type": "string"}},
         "additionalProperties": false}
      ]
    },
    "status": {"enum": ["待开奖", "已开奖", "失联"]}
  },
  "additionalProperties": false
}
